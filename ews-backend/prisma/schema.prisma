generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model reports {
  report_id                  String    @db.Uuid
  revision                   String    @db.VarChar(10)
  status                     String?   @db.VarChar(50)
  severity                   String?   @db.VarChar(20)
  title                      String?
  description                String?
  notes                      String?
  eyewitness                 Boolean?
  has_media                  Boolean?
  latest_version             Int?
  report_date_time           DateTime? @db.Timestamptz(6)
  incident_date_time         DateTime? @db.Timestamptz(6)
  update_timestamp           DateTime? @db.Timestamptz(6)
  
  // Location fields flattened
  woreda                     String?   @db.VarChar(100)
  zone                       String?   @db.VarChar(100)
  region                     String?   @db.VarChar(100)
  location_other             String?
  is_location_manual         Boolean?
  incident_location_inferred Boolean?
  
  // GPS Coordinates
  latitude                   Decimal?  @db.Decimal(15, 12)
  longitude                  Decimal?  @db.Decimal(15, 12)
  gps_calculated             Boolean?
  
  // Reporter & Analyst Auditing
  reporter_name              String?   @db.VarChar(150)
  reporter_sub               String?   @db.Uuid
  analyst_name               String?   @db.VarChar(150)
  analyst_sub                String?   @db.Uuid
  
  // Categories and Media stored as standard Postgres Arrays
  categories                 String[]
  media_files                String[]
  media_files_mime           String[]

  @@id([report_id, revision])
}


model user_roles {
  user_id String @db.Uuid
  role    String
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role])
}

model users {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String       @unique
  password   String
  enabled    Boolean?     @default(true)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  role       String?
  user_roles user_roles[]
}

model students {
  id         Int      @id @default(autoincrement())
  student_id String   @unique @db.VarChar(50)
  name       String   @db.VarChar(100)
  email      String?  @db.VarChar(100)
  department String   @db.VarChar(100)
  class_year Int
  status     String   @default("active") @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(6)
}

