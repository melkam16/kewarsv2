{
  "version": 2,
  "builds": [
    {
      "src": "ews-backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "ews-backend/server.js"
    },
    {
      "src": "/static/(.*)",
      "dest": "/web/static/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/web/favicon.ico"
    },
    {
      "src": "/logo192.png",
      "dest": "/web/logo192.png"
    },
    {
      "src": "/logo512.png",
      "dest": "/web/logo512.png"
    },
    {
      "src": "/manifest.json",
      "dest": "/web/manifest.json"
    },
    {
      "src": "/map.html",
      "dest": "/web/map.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/web/robots.txt"
    },
    {
      "src": "/topojson.log",
      "dest": "/web/topojson.log"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/web/index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    }
  ]
}
